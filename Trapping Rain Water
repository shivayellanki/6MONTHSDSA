height = [0,1,0,2,1,0,1,3,2,1,2,1]
l = 0
r = len(height) - 1
leftmax = 0
rightmax = 0
water = 0
while l < r:
    if leftmax < rightmax:
        l += 1
        leftmax = max(leftmax, height[l])
        water += leftmax - height[l]
    else:
        r -= 1
        rightmax = max(rightmax, height[r])
        water += rightmax - height[r]
print(water)
